{
  "name": "mythic-legends",
  "tree": {
    "$className": "DataModel",

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "Map": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Spawns": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Visuals": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Runtime": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Bases": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Network": {
        "$className": "Folder",
        "State": {
          "$className": "Folder",
          "Update": { "$className": "RemoteEvent" },
          "Request": { "$className": "RemoteFunction" }
        },
        "Inventory": {
          "$className": "Folder",
          "DeleteMythling": { "$className": "RemoteFunction" }
        },
        "Production": {
          "$className": "Folder",
          "GetStatus": { "$className": "RemoteFunction" },
          "Collect": { "$className": "RemoteFunction" }
        },
        "Base": {
          "$className": "Folder",
          "PlaceMythling": { "$className": "RemoteFunction" },
          "RemoveMythling": { "$className": "RemoteFunction" }
        },
        "Combat": {
          "$className": "Folder",
          "StartAttack": { "$className": "RemoteEvent" },
          "ReportHit": { "$className": "RemoteEvent" },
          "SetShieldGuard": { "$className": "RemoteEvent" },
          "Reaction": { "$className": "RemoteEvent" },
          "Impact": { "$className": "RemoteEvent" },
          "GetLoadout": { "$className": "RemoteFunction" },
          "Equip": { "$className": "RemoteFunction" }
        },
        "World": {
          "$className": "Folder",
          "Spawned": { "$className": "RemoteEvent" },
          "ClaimState": { "$className": "RemoteEvent" }
        }
      },
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Audio": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Equipment": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "MythlingPreviews": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Templates": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "UI": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "Components": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MainServer": {
        "$path": "src/ServerScriptService/MainServer"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      },
      "Infrastructure": {
        "$path": "src/ServerScriptService/Infrastructure"
      },
      "Packages": {
        "$path": "src/ServerScriptService/Packages"
      },
      "PostLaunch": {
        "$path": "src/ServerScriptService/PostLaunch"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "Databases": {
        "$path": "src/ServerStorage/Databases"
      },
      "ServerAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Bases": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$ignoreUnknownInstances": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MainClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/MainClient"
        },
        "Controllers": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Controllers"
        },
        "State": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/State"
        },
        "Character": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Character"
        },
        "UI": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/UI"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "InventoryGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      },
      "ShopGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Enabled": false,
          "ResetOnSpawn": false
        }
      },
      "StandGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      },
      "HUDGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      },
      "HotbarGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      }
    }
  }
}
