{
  "name": "mythic-legends",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Util": {
        "$path": "src/shared/Util"
      },
      "Metadata": {
        "$path": "src/shared/Metadata"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Services": {
        "$path": "src/server/Services"
      },
      "Bootstrap": {
        "$path": "src/server/Bootstrap.server.lua"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client/StarterPlayerScripts"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "InventoryGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/InventoryGui"
      },
      "StandGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/StandGui"
      },
      "MainGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/MainGui"
      },
      "HotbarGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/HotbarGui"
      }
    }
  }
}
