{
  "name": "mythic-legends",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/client/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "WeaponAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "PerformAttack": {
        "$className": "RemoteEvent"
      },
      "SetShieldGuard": {
        "$className": "RemoteEvent"
      },
      "CombatImpact": {
        "$className": "RemoteEvent"
      },
      "CombatLoadoutRequest": {
        "$className": "RemoteFunction"
      },
      "Metadata": {
        "$path": "src/shared/Metadata"
      },
      "Shared": {
        "$className": "Folder",
        "ArenaBounds": {
          "$path": "src/shared/ArenaBounds.lua"
        },
        "Types": {
          "$path": "src/shared/Types.lua"
        }
      },
      "Client": {
        "$path": "src/client/Modules"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "EquipmentStateManager": {
        "$path": "src/server/EquipmentStateManager.server.lua"
      },
      "Infrastructure": {
        "$path": "src/server/Infrastructure"
      },
      "Services": {
        "$path": "src/server/Services"
      },
      "Bootstrap": {
        "$path": "src/server/Bootstrap.server.lua"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client/StarterPlayerScripts"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "InventoryGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/InventoryGui"
      },
      "ShopGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/ShopGui",
        "$properties": {
          "Enabled": false,
          "ResetOnSpawn": false
        }
      },
      "StandGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/StandGui"
      },
      "HUDGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/HUDGui"
      },
      "HotbarGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$path": "src/client/StarterGui/HotbarGui"
      }
    }
  }
}
