{
  "name": "mythic-legends",
  "tree": {
    "$className": "DataModel",

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "Map": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Spawns": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Visuals": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Runtime": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Bases": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/client/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Network": {
        "$className": "Folder",
        "AdminEvent": { "$className": "RemoteEvent" },
        "BaseEvent": { "$className": "RemoteEvent" },
        "ClaimEvent": { "$className": "RemoteEvent" },
        "CombatImpact": { "$className": "RemoteEvent" },
        "CurrencyEvent": { "$className": "RemoteEvent" },
        "MythlingsEvent": { "$className": "RemoteEvent" },
        "PerformAttack": { "$className": "RemoteEvent" },
        "SetShieldGuard": { "$className": "RemoteEvent" },
        "SpawnEvent": { "$className": "RemoteEvent" },
        "UpdateState": { "$className": "RemoteEvent" },
        "CombatLoadoutRequest": { "$className": "RemoteFunction" },
        "ConsumablesRequest": { "$className": "RemoteFunction" },
        "GetStands": { "$className": "RemoteFunction" },
        "MaterialsRequest": { "$className": "RemoteFunction" },
        "MythlingsRequest": { "$className": "RemoteFunction" },
        "RequestState": { "$className": "RemoteFunction" }
      },
      "SharedModules": {
        "$path": "src/shared/SharedModules"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Audio": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Equipment": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "MythlingPreviews": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Templates": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "UI": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "Components": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "MainServer": {
        "$path": "src/server/MainServer"
      },
      "ServerModules": {
        "$path": "src/server/ServerModules"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "Databases": {
        "$path": "src/server/Databases"
      },
      "ServerAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Bases": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$ignoreUnknownInstances": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "MainClient": {
          "$path": "src/client/MainClient"
        },
        "ClientModules": {
          "$path": "src/client/ClientModules"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "InventoryGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      },
      "ShopGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Enabled": false,
          "ResetOnSpawn": false
        }
      },
      "StandGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      },
      "HUDGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      },
      "HotbarGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "ResetOnSpawn": false
        }
      }
    }
  }
}
