{
  "name": "mythic-legends",
  "tree": {
    "$className": "DataModel",

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "World": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "BaseIslands": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Bridges": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "ElementalIslands": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Atmosphere": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      },
      "Runtime": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Bases": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Network": {
        "$className": "Folder",
        "Admin": {
          "$className": "Folder",
          "Feedback": { "$className": "RemoteEvent" }
        },
        "State": {
          "$className": "Folder",
          "Update": { "$className": "RemoteEvent" },
          "Request": { "$className": "RemoteFunction" }
        },
        "Inventory": {
          "$className": "Folder",
          "DeleteMythling": { "$className": "RemoteFunction" },
          "EvolveMythling": { "$className": "RemoteFunction" },
          "SellMythling": { "$className": "RemoteFunction" },
          "SellEquipment": { "$className": "RemoteFunction" },
          "SellMaterial": { "$className": "RemoteFunction" },
          "DiscardMaterial": { "$className": "RemoteFunction" },
          "UpgradeCapacity": { "$className": "RemoteFunction" }
        },
        "Shop": {
          "$className": "Folder",
          "GetShop": { "$className": "RemoteFunction" },
          "BuyOffer": { "$className": "RemoteFunction" }
        },
        "Crafting": {
          "$className": "Folder",
          "GetStation": { "$className": "RemoteFunction" },
          "StartJob": { "$className": "RemoteFunction" },
          "CancelJob": { "$className": "RemoteFunction" }
        },
        "Production": {
          "$className": "Folder",
          "GetStatus": { "$className": "RemoteFunction" },
          "Collect": { "$className": "RemoteFunction" },
          "CollectShrine": { "$className": "RemoteFunction" }
        },
        "Base": {
          "$className": "Folder",
          "GetBase": { "$className": "RemoteFunction" },
          "BuildShrine": { "$className": "RemoteFunction" },
          "ExpandBase": { "$className": "RemoteFunction" },
          "GetShrine": { "$className": "RemoteFunction" },
          "AssignShrineWorker": { "$className": "RemoteFunction" },
          "RemoveShrineWorker": { "$className": "RemoteFunction" },
          "UpgradeShrine": { "$className": "RemoteFunction" },
          "DismantleShrine": { "$className": "RemoteFunction" },
          "PlaceMythling": { "$className": "RemoteFunction" },
          "RemoveMythling": { "$className": "RemoteFunction" }
        },
        "Combat": {
          "$className": "Folder",
          "StartAttack": { "$className": "RemoteEvent" },
          "ReportHit": { "$className": "RemoteEvent" },
          "SetShieldGuard": { "$className": "RemoteEvent" },
          "Reaction": { "$className": "RemoteEvent" },
          "Impact": { "$className": "RemoteEvent" },
          "GetLoadout": { "$className": "RemoteFunction" },
          "Equip": { "$className": "RemoteFunction" },
          "EquipEquipment": { "$className": "RemoteFunction" },
          "UnequipEquipment": { "$className": "RemoteFunction" }
        },
        "World": {
          "$className": "Folder",
          "Spawned": { "$className": "RemoteEvent" },
          "ClaimState": { "$className": "RemoteEvent" }
        }
      },
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Audio": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Equipment": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Templates": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "UI": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "Components": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MainServer": {
        "$path": "src/ServerScriptService/MainServer.server.lua"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      },
      "Infrastructure": {
        "$path": "src/ServerScriptService/Infrastructure"
      },
      "Shared": {
        "$path": "src/ServerScriptService/Shared"
      },
      "Packages": {
        "$path": "src/ServerScriptService/Packages"
      },
      "PostLaunch": {
        "$path": "src/ServerScriptService/PostLaunch"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "Databases": {
        "$path": "src/ServerStorage/Databases"
      },
      "ServerAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Bases": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      },
      "Authoring": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Backups": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Mythlings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "TemplateSources": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$ignoreUnknownInstances": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MainClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/MainClient.client.lua"
        },
        "Controllers": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Controllers"
        },
        "State": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/State"
        },
        "Types": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Types.lua"
        },
        "Character": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Character"
        },
        "UI": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/UI"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui"
    },

    "TextChatService": {
      "$className": "TextChatService",
      "$ignoreUnknownInstances": true,
      "AdminCommand": {
        "$className": "TextChatCommand",
        "$properties": {
          "PrimaryAlias": "/admin",
          "Enabled": true,
          "AutocompleteVisible": true
        }
      }
    }
  }
}
